# Copy to .env to override the defaults used by "npm start", "npm run register"
# and the integration tests. Every line is optional.

# Conductor API base URL. A bare server root gets /api appended.
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Only for Conductor servers that require authentication (Orkes).
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=

# Conductor UI base URL, for the "see the workflow" links on receipts and
# decisions. Locally it defaults to the Conductor server root.
# CONDUCTOR_UI_URL=http://localhost:8080

# Port for the local store.
# PORT=3000

# Origins allowed to call the API (comma-separated), or * for any.
# ALLOWED_ORIGINS=*

# Seconds a return waits for the Returns Oath (5-600) and pauses after each
# pointless check (1-5).
# OATH_WINDOW_SECONDS=60
# CHECK_PAUSE_SECONDS=1
