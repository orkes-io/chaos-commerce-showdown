# Conductor server API endpoint (local OSS default; never stopped/restarted by Chaos Commerce)
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Optional override for Conductor UI links shown in the store's Workflow Inspector
CONDUCTOR_UI_URL=http://localhost:8080

# Optional Conductor auth (only needed when pointing AWS Lambda at Orkes / Enterprise Conductor)
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=

# Local unified store + API port
PORT=3000

# CORS allowed origin on backend / AWS Lambda (* or your GitHub Pages origin, e.g. https://<owner>.github.io)
CORS_ORIGIN=*

# Frontend build-time API base URL:
# - Leave empty for local unified server (`http://localhost:3000`)
# - Set to your AWS API Gateway / Lambda Function URL when building for GitHub Pages
VITE_API_BASE_URL=
