{
  "name": "chaos-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chaos Commerce — A parody online store powered by deterministic Conductor workflows, structured for GitHub Pages + AWS Lambda.",
  "scripts": {
    "start": "bash ./start.sh",
    "register-workflows": "node ./workflows/register.mjs",
    "build": "npm --prefix frontend run build && node ./scripts/package-lambda.mjs",
    "build:pages": "npm --prefix frontend run build",
    "package:lambda": "node ./scripts/package-lambda.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node ./backend/src/local-server.mjs",
    "test": "node ./scripts/verify-e2e.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
