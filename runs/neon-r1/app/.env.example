# Conductor server API URL (must include /api)
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Optional Conductor UI base URL (defaults to CONDUCTOR_SERVER_URL without /api)
CONDUCTOR_UI_URL=http://localhost:8080

# Optional Conductor auth (for Orkes / authenticated remote clusters; leave blank for OSS)
CONDUCTOR_AUTH_KEY=
CONDUCTOR_AUTH_SECRET=

# Local unified server port
PORT=3000

# Allowed CORS origin for backend API (set to your GitHub Pages origin in production, or *)
CORS_ORIGIN=*

# Optional local JSON persistence path (disabled automatically on AWS Lambda)
DATA_FILE=./data/chaos-commerce-data.json

# Frontend build-time API URL (leave empty for same-origin local server; set to API Gateway URL for GitHub Pages)
VITE_API_BASE_URL=
