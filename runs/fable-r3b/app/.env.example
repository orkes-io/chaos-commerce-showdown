# Copy to .env to override the defaults used by `npm start` and `npm run register`.
# Variables set in the shell win over this file.

# Conductor API base URL ("/api" is appended if you give a bare server root).
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Only for a Conductor server that requires authentication (e.g. Orkes).
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=

# Port of the local store.
PORT=3000

# Origin allowed to call the API from another site ("*" = any).
ALLOWED_ORIGIN=*

# How long POST /api/checkout waits for the workflow before answering 202.
CHECKOUT_WAIT_MS=12000

# ownerEmail written into the workflow definitions when they are registered.
WORKFLOW_OWNER_EMAIL=chaos-commerce@example.com
