# Conductor Server API URL (must include or auto-appends /api)
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Optional Conductor UI URL for deep links (defaults to CONDUCTOR_SERVER_URL without /api)
CONDUCTOR_UI_URL=http://localhost:8080

# Optional Conductor auth (leave blank for OSS Conductor without auth; never commit secrets!)
# CONDUCTOR_AUTH_TOKEN=
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=

# Local server port
PORT=3000

# Allowed CORS origin for API responses (set to https://<user>.github.io in AWS Lambda)
CORS_ORIGIN=*

# Frontend build-time API base URL (leave blank locally; set to AWS Lambda API URL for GitHub Pages)
# VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
