# Conductor API base URL (must include /api for Conductor OSS/Orkes REST endpoints)
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Optional Conductor UI base URL (derived from CONDUCTOR_SERVER_URL by stripping /api if omitted)
CONDUCTOR_UI_URL=http://localhost:8080

# Optional auth for Orkes Conductor Enterprise (leave empty for local OSS Conductor)
CONDUCTOR_AUTH_KEY=
CONDUCTOR_AUTH_SECRET=

# Local server port
PORT=3000

# CORS allowed origins (comma-separated, or * for demo/GitHub Pages)
CORS_ORIGIN=*

# Frontend build-time API base URL (leave blank for same-origin at http://localhost:3000;
# set to your AWS Lambda API Gateway URL when building for GitHub Pages)
VITE_API_BASE_URL=
