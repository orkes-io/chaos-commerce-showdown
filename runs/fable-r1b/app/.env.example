# Copy to .env (npm start and npm run register read it). Real environment variables win over this file.

# Conductor API base URL. "/api" is appended automatically if you give a bare root such as http://localhost:8080
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Optional: base URL of the Conductor UI for "view execution" links. Defaults to CONDUCTOR_SERVER_URL without /api.
# CONDUCTOR_UI_URL=http://localhost:8080

# Optional: credentials for a secured (Orkes) Conductor. Leave unset for an open OSS server.
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=

# Optional tuning
# PORT=3000                      # local store port
# HOST=127.0.0.1                 # bind address (default: all interfaces)
# CORS_ALLOW_ORIGIN=*            # origin allowed to call the API
# CONDUCTOR_TIMEOUT_MS=12000     # per-request timeout towards Conductor
# CHECKOUT_WAIT_MS=8000          # how long POST /api/checkout waits for the confirmation
