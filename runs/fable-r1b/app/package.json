{
  "name": "chaos-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "A parody online store whose checkout and returns run as Conductor workflows.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "register": "node scripts/register-workflows.mjs",
    "build:workflows": "node backend/workflows/src/build.mjs",
    "test": "node backend/workflows/src/build.mjs --check && node --test backend/test/*.test.mjs",
    "e2e": "node scripts/e2e.mjs"
  }
}
