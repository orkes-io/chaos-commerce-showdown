{
  "name": "chaos_return_workflow",
  "description": "Chaos Commerce return adjudication pipeline: runs 4 parallel pointless forensic and astrological checks, evaluates contrition forensics, loops through a 3-desk bureaucratic rubber-stamp committee, routes verdict via SWITCH, and issues a binding return decision.",
  "version": 1,
  "schemaVersion": 2,
  "restartable": true,
  "ownerEmail": "chaos-ops@chaoscommerce.example",
  "timeoutPolicy": "TIME_OUT_WF",
  "timeoutSeconds": 120,
  "inputParameters": [
    "returnId",
    "orderId",
    "itemName",
    "itemPrice",
    "reason",
    "moonPhase",
    "eyeContactSeconds",
    "originalAirPercent",
    "tapeStripCount",
    "tearsShed",
    "sworeHubrisOath",
    "didNotFeedAfterMidnight",
    "apologyText"
  ],
  "variables": {
    "branchPolicy": "CHAOS_STORE_CREDIT"
  },
  "tasks": [
    {
      "name": "pointless_checks_fork",
      "taskReferenceName": "pointless_checks_fork_ref",
      "type": "FORK_JOIN",
      "forkTasks": [
        [
          {
            "name": "check_lunar_alignment",
            "taskReferenceName": "check_lunar_alignment_ref",
            "type": "INLINE",
            "inputParameters": {
              "evaluatorType": "graaljs",
              "moon": "${workflow.input.moonPhase}",
              "expression": "(function(){ var m = String($.moon || 'unknown'); var good = m === 'suspiciously_cheese' || m === 'waning_crescent'; return { checkName: 'Check #1: Lunar & Astrological Remorse Alignment', passed: good, score: good ? 20 : 5, finding: good ? 'Moon phase (' + m + ') radiates acceptable buyer regret.' : 'Moon phase (' + m + ') conflicts with Warehouse Capricorn Policy (-15 pts).' }; })();"
            }
          }
        ],
        [
          {
            "name": "check_factory_air_molecules",
            "taskReferenceName": "check_factory_air_molecules_ref",
            "type": "INLINE",
            "inputParameters": {
              "evaluatorType": "graaljs",
              "airPct": "${workflow.input.originalAirPercent}",
              "tapeCount": "${workflow.input.tapeStripCount}",
              "expression": "(function(){ var air = Number($.airPct || 0); var tape = Number($.tapeCount || 0); var ok = air >= 65 && tape >= 3 && tape <= 19; return { checkName: 'Check #2: Original 2019 Factory Air & Tape Strip Forensics', passed: ok, score: ok ? 20 : 5, finding: ok ? air + '% factory oxygen retained with ' + tape + ' regulation tape strips.' : 'Only ' + air + '% factory air left and ' + tape + ' tape strips applied (strictly requires >=65% air & 3-19 strips).' }; })();"
            }
          }
        ],
        [
          {
            "name": "check_contrition_and_eye_contact",
            "taskReferenceName": "check_contrition_and_eye_contact_ref",
            "type": "INLINE",
            "inputParameters": {
              "evaluatorType": "graaljs",
              "eyeSec": "${workflow.input.eyeContactSeconds}",
              "tears": "${workflow.input.tearsShed}",
              "apology": "${workflow.input.apologyText}",
              "expression": "(function(){ var sec = Number($.eyeSec || 0); var t = Number($.tears || 0); var len = String($.apology || '').trim().length; var ok = sec >= 14 && t >= 2 && len >= 20; return { checkName: 'Check #3: Unbroken Eye Contact & Tear Salinity Audit', passed: ok, score: ok ? 20 : 5, finding: ok ? 'Maintained ' + sec + 's eye contact, shed ' + t + ' tears, and wrote ' + len + ' chars of groveling.' : 'Insufficient contrition (' + sec + 's stare, ' + t + ' tears, ' + len + ' chars; minimum 14s, 2 tears, 20 chars).' }; })();"
            }
          }
        ],
        [
          {
            "name": "check_oath_compliance_jq",
            "taskReferenceName": "check_oath_compliance_jq_ref",
            "type": "JSON_JQ_TRANSFORM",
            "inputParameters": {
              "hubris": "${workflow.input.sworeHubrisOath}",
              "midnight": "${workflow.input.didNotFeedAfterMidnight}",
              "price": "${workflow.input.itemPrice}",
              "queryExpression": "{ checkName: \"Check #4: Sacred Midnight Gremlin & Hubris Oath Verification\", passed: (.hubris == true and .midnight == true), score: (if (.hubris == true and .midnight == true) then 20 else 5 end), annoyanceTariff: (if (.price | tonumber) > 100 then 19.99 else 4.99 end), finding: (if (.hubris == true and .midnight == true) then \"Both statutory oaths sworn under penalty of mild side-eye.\" else \"Shopper hesitated on Sacred Hubris or Post-Midnight Feeding Oath.\" end) }"
            }
          }
        ]
      ]
    },
    {
      "name": "pointless_checks_join",
      "taskReferenceName": "pointless_checks_join_ref",
      "type": "JOIN",
      "joinOn": [
        "check_lunar_alignment_ref",
        "check_factory_air_molecules_ref",
        "check_contrition_and_eye_contact_ref",
        "check_oath_compliance_jq_ref"
      ]
    },
    {
      "name": "chaos_inspect_return_forensics",
      "taskReferenceName": "forensics_inspection_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "returnId": "${workflow.input.returnId}",
        "orderId": "${workflow.input.orderId}",
        "itemName": "${workflow.input.itemName}",
        "itemPrice": "${workflow.input.itemPrice}",
        "reason": "${workflow.input.reason}",
        "apologyText": "${workflow.input.apologyText}",
        "lunarCheck": "${check_lunar_alignment_ref.output.result}",
        "airCheck": "${check_factory_air_molecules_ref.output.result}",
        "contritionCheck": "${check_contrition_and_eye_contact_ref.output.result}",
        "oathCheck": "${check_oath_compliance_jq_ref.output.result}"
      }
    },
    {
      "name": "committee_stamp_loop",
      "taskReferenceName": "committee_stamp_loop_ref",
      "type": "DO_WHILE",
      "evaluatorType": "graaljs",
      "inputParameters": {
        "committee_stamp_loop_ref": "${committee_stamp_loop_ref.output}"
      },
      "loopCondition": "(function(){ var i = $.committee_stamp_loop_ref['iteration'] || 1; return i < 3; })();",
      "loopOver": [
        {
          "name": "rubber_stamp_desk",
          "taskReferenceName": "rubber_stamp_desk_ref",
          "type": "INLINE",
          "inputParameters": {
            "evaluatorType": "graaljs",
            "iter": "${committee_stamp_loop_ref.output.iteration}",
            "score": "${forensics_inspection_ref.output.totalScore}",
            "expression": "(function(){ var n = Number($.iter || 1); var desks = ['Desk 14-A: Sub-Directorate of Heavy Sighing', 'Desk 27-B: Grand Notary of Crumpled Receipts', 'Desk 99-Z: Supreme High Chancellor of Cardboard']; var notes = ['Stamped with purple ink after a 4-minute coffee sip.', 'Cross-referenced against 1994 Maritime Bird Law; initialed.', 'Sealed with wax and mild bureaucratic resentment.']; return { deskNumber: n, deskName: desks[(n - 1) % 3], stampNote: notes[(n - 1) % 3], scoreSeen: $.score }; })();"
          }
        }
      ]
    },
    {
      "name": "verdict_routing_switch",
      "taskReferenceName": "verdict_routing_switch_ref",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "switchCaseValue",
      "inputParameters": {
        "switchCaseValue": "${forensics_inspection_ref.output.verdictTier}"
      },
      "decisionCases": {
        "MIRACLE_FULL_REFUND": [
          {
            "name": "set_miracle_policy",
            "taskReferenceName": "set_miracle_policy_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "branchPolicy": "MIRACLE_FULL_REFUND"
            }
          }
        ],
        "PARTIAL_MINUS_AUDACITY_FEES": [
          {
            "name": "set_partial_policy",
            "taskReferenceName": "set_partial_policy_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "branchPolicy": "PARTIAL_MINUS_AUDACITY_FEES"
            }
          }
        ],
        "CHAOS_STORE_CREDIT": [
          {
            "name": "set_credit_policy",
            "taskReferenceName": "set_credit_policy_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "branchPolicy": "CHAOS_STORE_CREDIT"
            }
          }
        ],
        "DENIED_BUREAUCRATICALLY": [
          {
            "name": "set_denied_policy",
            "taskReferenceName": "set_denied_policy_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "branchPolicy": "DENIED_BUREAUCRATICALLY"
            }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "set_fallback_policy",
          "taskReferenceName": "set_fallback_policy_ref",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "branchPolicy": "CHAOS_STORE_CREDIT"
          }
        }
      ]
    },
    {
      "name": "chaos_issue_return_verdict",
      "taskReferenceName": "issue_verdict_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "returnId": "${workflow.input.returnId}",
        "orderId": "${workflow.input.orderId}",
        "itemName": "${workflow.input.itemName}",
        "itemPrice": "${workflow.input.itemPrice}",
        "reason": "${workflow.input.reason}",
        "branchPolicy": "${workflow.variables.branchPolicy}",
        "totalScore": "${forensics_inspection_ref.output.totalScore}",
        "checksAudit": "${forensics_inspection_ref.output.checksAudit}",
        "annoyanceTariff": "${check_oath_compliance_jq_ref.output.result.annoyanceTariff}",
        "committeeLoopOutput": "${committee_stamp_loop_ref.output}"
      }
    }
  ],
  "outputParameters": {
    "decisionReached": "${issue_verdict_ref.output.decisionReached}",
    "returnId": "${issue_verdict_ref.output.returnId}",
    "orderId": "${issue_verdict_ref.output.orderId}",
    "decisionCode": "${issue_verdict_ref.output.decisionCode}",
    "decisionTitle": "${issue_verdict_ref.output.decisionTitle}",
    "approved": "${issue_verdict_ref.output.approved}",
    "refundAmount": "${issue_verdict_ref.output.refundAmount}",
    "chaosBucksCredit": "${issue_verdict_ref.output.chaosBucksCredit}",
    "deductions": "${issue_verdict_ref.output.deductions}",
    "totalScore": "${forensics_inspection_ref.output.totalScore}",
    "checksAudit": "${issue_verdict_ref.output.checksAudit}",
    "committeeIterations": "${committee_stamp_loop_ref.output.iteration}",
    "committeeStamps": "${issue_verdict_ref.output.committeeStamps}",
    "officialRuling": "${issue_verdict_ref.output.officialRuling}",
    "appealInstructions": "${issue_verdict_ref.output.appealInstructions}"
  }
}
