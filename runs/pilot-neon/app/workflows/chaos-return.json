{
  "name": "chaos_return",
  "description": "Chaos Commerce returns workflow: subjects every return to parallel pointless checks, a bounded 3-stamp bureaucracy DO_WHILE loop, JQ aggregation, and a SWITCH decision tree that ALWAYS reaches a final verdict.",
  "version": 1,
  "schemaVersion": 2,
  "restartable": true,
  "ownerEmail": "ops@chaos-commerce.example",
  "timeoutPolicy": "TIME_OUT_WF",
  "timeoutSeconds": 300,
  "variables": {
    "resolutionArtifact": "CHAOS-RESOLUTION-PENDING",
    "nextSteps": "Wait politely while our carrier pigeon forgets your address."
  },
  "inputParameters": [
    "orderId",
    "customerName",
    "itemName",
    "orderTotal",
    "reason",
    "moonPhase",
    "raccoonDeclaration",
    "barleycornWeight",
    "boxAura",
    "haikuOfRegret",
    "whisperedApology",
    "termsRead"
  ],
  "tasks": [
    {
      "name": "intake_return_dossier",
      "taskReferenceName": "intake_return_dossier_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${workflow.input.orderId}",
        "customerName": "${workflow.input.customerName}",
        "itemName": "${workflow.input.itemName}",
        "orderTotal": "${workflow.input.orderTotal}",
        "reason": "${workflow.input.reason}",
        "termsRead": "${workflow.input.termsRead}"
      }
    },
    {
      "name": "pointless_checks_fork",
      "taskReferenceName": "pointless_checks_fork_ref",
      "type": "FORK_JOIN",
      "forkTasks": [
        [
          {
            "name": "check_mercury_retrograde",
            "taskReferenceName": "check_mercury_retrograde_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "moonPhase": "${workflow.input.moonPhase}",
              "caseNumber": "${intake_return_dossier_ref.output.caseNumber}"
            }
          }
        ],
        [
          {
            "name": "verify_raccoon_status",
            "taskReferenceName": "verify_raccoon_status_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "raccoonDeclaration": "${workflow.input.raccoonDeclaration}",
              "customerName": "${workflow.input.customerName}"
            }
          }
        ],
        [
          {
            "name": "weigh_in_barleycorns",
            "taskReferenceName": "weigh_in_barleycorns_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "barleycornWeight": "${workflow.input.barleycornWeight}",
              "boxAura": "${workflow.input.boxAura}"
            }
          }
        ],
        [
          {
            "name": "grade_haiku_of_regret",
            "taskReferenceName": "grade_haiku_of_regret_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "haikuOfRegret": "${workflow.input.haikuOfRegret}",
              "whisperedApology": "${workflow.input.whisperedApology}"
            }
          }
        ]
      ]
    },
    {
      "name": "pointless_checks_join",
      "taskReferenceName": "pointless_checks_join_ref",
      "type": "JOIN",
      "joinOn": [
        "check_mercury_retrograde_ref",
        "verify_raccoon_status_ref",
        "weigh_in_barleycorns_ref",
        "grade_haiku_of_regret_ref"
      ]
    },
    {
      "name": "rubber_stamp_loop",
      "taskReferenceName": "rubber_stamp_loop_ref",
      "type": "DO_WHILE",
      "evaluatorType": "graaljs",
      "loopCondition": "(function(){ return $.rubber_stamp_loop_ref['iteration'] < $.requiredStamps && $.rubber_stamp_loop_ref['iteration'] < 5; })();",
      "inputParameters": {
        "rubber_stamp_loop_ref": "${rubber_stamp_loop_ref.output}",
        "requiredStamps": "${intake_return_dossier_ref.output.requiredStamps}"
      },
      "loopOver": [
        {
          "name": "apply_redundant_stamp",
          "taskReferenceName": "apply_redundant_stamp_ref",
          "type": "SIMPLE",
          "inputParameters": {
            "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
            "iteration": "${rubber_stamp_loop_ref.output.iteration}"
          }
        }
      ]
    },
    {
      "name": "summarize_bureaucracy",
      "taskReferenceName": "summarize_bureaucracy_ref",
      "type": "JSON_JQ_TRANSFORM",
      "inputParameters": {
        "astrology": "${check_mercury_retrograde_ref.output}",
        "raccoon": "${verify_raccoon_status_ref.output}",
        "barleycorns": "${weigh_in_barleycorns_ref.output}",
        "haiku": "${grade_haiku_of_regret_ref.output}",
        "stampsCount": "${rubber_stamp_loop_ref.output.iteration}",
        "queryExpression": "{ checks: [ { name: \"Planetary & Moon Phase Audit\", passed: .astrology.passed, points: .astrology.points, note: .astrology.note }, { name: \"Anti-Raccoon Species Verification\", passed: .raccoon.passed, points: .raccoon.points, note: .raccoon.note }, { name: \"Barleycorn Weight & Box Aura Inspection\", passed: .barleycorns.passed, points: .barleycorns.points, note: .barleycorns.note }, { name: \"Haiku of Regret Literary Tribunal\", passed: .haiku.passed, points: .haiku.points, note: .haiku.note } ], totalPoints: ((.astrology.points // 0) + (.raccoon.points // 0) + (.barleycorns.points // 0) + (.haiku.points // 0)), stampsApplied: (.stampsCount // 3) }"
      }
    },
    {
      "name": "evaluate_return_verdict",
      "taskReferenceName": "evaluate_return_verdict_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
        "orderId": "${intake_return_dossier_ref.output.orderId}",
        "orderTotal": "${intake_return_dossier_ref.output.orderTotal}",
        "reason": "${intake_return_dossier_ref.output.reason}",
        "whisperedApology": "${workflow.input.whisperedApology}",
        "totalPoints": "${summarize_bureaucracy_ref.output.result.totalPoints}",
        "stampsApplied": "${summarize_bureaucracy_ref.output.result.stampsApplied}"
      }
    },
    {
      "name": "route_return_decision",
      "taskReferenceName": "route_return_decision_ref",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "decisionCode",
      "inputParameters": {
        "decisionCode": "${evaluate_return_verdict_ref.output.decisionCode}"
      },
      "decisionCases": {
        "APPROVED_STORE_CREDIT": [
          {
            "name": "issue_store_credit_voucher",
            "taskReferenceName": "issue_store_credit_voucher_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
              "storeCreditAmount": "${evaluate_return_verdict_ref.output.storeCreditAmount}"
            }
          },
          {
            "name": "set_store_credit_vars",
            "taskReferenceName": "set_store_credit_vars_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "resolutionArtifact": "${issue_store_credit_voucher_ref.output.resolutionArtifact}",
              "nextSteps": "${issue_store_credit_voucher_ref.output.nextSteps}"
            }
          }
        ],
        "APPROVED_MINUS_ABSURD_FEES": [
          {
            "name": "issue_fee_nibbled_refund",
            "taskReferenceName": "issue_fee_nibbled_refund_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
              "refundAmount": "${evaluate_return_verdict_ref.output.refundAmount}",
              "restockingFee": "${evaluate_return_verdict_ref.output.restockingFee}"
            }
          },
          {
            "name": "set_fee_refund_vars",
            "taskReferenceName": "set_fee_refund_vars_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "resolutionArtifact": "${issue_fee_nibbled_refund_ref.output.resolutionArtifact}",
              "nextSteps": "${issue_fee_nibbled_refund_ref.output.nextSteps}"
            }
          }
        ],
        "APPROVED_IN_DOUBLOONS": [
          {
            "name": "mint_chaos_doubloons",
            "taskReferenceName": "mint_chaos_doubloons_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
              "refundAmount": "${evaluate_return_verdict_ref.output.refundAmount}"
            }
          },
          {
            "name": "set_doubloon_vars",
            "taskReferenceName": "set_doubloon_vars_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "resolutionArtifact": "${mint_chaos_doubloons_ref.output.resolutionArtifact}",
              "nextSteps": "${mint_chaos_doubloons_ref.output.nextSteps}"
            }
          }
        ],
        "DENIED_WITH_CONFETTI": [
          {
            "name": "dispatch_consolation_confetti",
            "taskReferenceName": "dispatch_consolation_confetti_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
              "orderId": "${intake_return_dossier_ref.output.orderId}"
            }
          },
          {
            "name": "set_denied_vars",
            "taskReferenceName": "set_denied_vars_ref",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "resolutionArtifact": "${dispatch_consolation_confetti_ref.output.resolutionArtifact}",
              "nextSteps": "${dispatch_consolation_confetti_ref.output.nextSteps}"
            }
          }
        ]
      },
      "defaultCase": []
    }
  ],
  "outputParameters": {
    "caseNumber": "${intake_return_dossier_ref.output.caseNumber}",
    "orderId": "${intake_return_dossier_ref.output.orderId}",
    "itemName": "${intake_return_dossier_ref.output.itemName}",
    "decisionCode": "${evaluate_return_verdict_ref.output.decisionCode}",
    "decisionTitle": "${evaluate_return_verdict_ref.output.decisionTitle}",
    "decisionSummary": "${evaluate_return_verdict_ref.output.decisionSummary}",
    "approved": "${evaluate_return_verdict_ref.output.approved}",
    "refundAmount": "${evaluate_return_verdict_ref.output.refundAmount}",
    "storeCreditAmount": "${evaluate_return_verdict_ref.output.storeCreditAmount}",
    "restockingFee": "${evaluate_return_verdict_ref.output.restockingFee}",
    "bureaucracyScore": "${summarize_bureaucracy_ref.output.result.totalPoints}",
    "stampsApplied": "${rubber_stamp_loop_ref.output.iteration}",
    "checksPerformed": "${summarize_bureaucracy_ref.output.result.checks}",
    "resolutionArtifact": "${workflow.variables.resolutionArtifact}",
    "nextSteps": "${workflow.variables.nextSteps}",
    "decidedAt": "${evaluate_return_verdict_ref.output.decidedAt}"
  }
}
